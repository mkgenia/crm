    {
      "parameters": {
        "jsCode": "const ia = $('Generar Mensaje IA').first().json;\nconst cap = $('Reservar Contacto').first().json;\n\n// El generador responde JSON limpio ({ message }). Los fallbacks quedan por si\n// alguna vez se revierte a respuesta de texto plano.\nlet texto = '';\nif (typeof ia === 'string') texto = ia;\nelse if (ia.message) texto = ia.message;\nelse if (ia.data && ia.data.message) texto = ia.data.message;\nelse if (ia.text) texto = ia.text;\n\ntexto = String(texto).trim();\nif (!texto) throw new Error('El generador de IA no devolvio ningun mensaje');\n\n// El telefono ya viene normalizado a 34XXXXXXXXX desde el scraper.\nconst numero = String(cap.telefono).replace(/\\D/g, '');\n\nreturn [{ json: { number: numero, text: texto, captacion_id: cap.id } }];"
      },
