    {
      "parameters": {
        "jsCode": "// Un unico punto de control del ritmo de envio. Nada mas manda WhatsApps.\nconst ajustes = {};\nfor (const it of $('Leer Ajustes').all()) {\n  const r = it.json || {};\n  if (r.key) ajustes[r.key] = r.value;\n}\n\nif (String(ajustes.auto_contact_enabled) !== 'true') return [];\n\nconst limite = Number(ajustes.wa_limite_diario != null ? ajustes.wa_limite_diario : 25);\nconst enviadosHoy = $('Enviados Hoy').all()\n  .filter(function (i) { return i.json && i.json.id != null; }).length;\n\nif (enviadosHoy >= limite) return [];\n\n// Salto aleatorio del 45% de los turnos. Sin esto los mensajes saldrian clavados\n// cada 6 minutos, y esa regularidad milimetrica es de los primeros patrones que\n// usa WhatsApp para marcar una cuenta como automatizada. Con el salto, el hueco\n// entre envios queda entre 6 y ~30 min de forma irregular.\nif (Math.random() < 0.45) return [];\n\nreturn [{ json: { enviados_hoy: enviadosHoy, limite: limite } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        0
      ],
      "id": "wf3-decidir",
      "name": "Decidir Turno"
    },
